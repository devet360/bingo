{
  "name": "bingo-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "api:dev": "npm run dev -w @bingo/api",
    "api:build": "npm run build -w @bingo/api",
    "api:start": "npm run start -w @bingo/api",
    "api:test": "npm run test -w @bingo/api",
    "web:dev": "npm run dev -w @bingo/web",
    "web:build": "npm run build -w @bingo/web",
    "web:start": "npm run start -w @bingo/web",
    "web:typecheck": "npm run typecheck -w @bingo/web",
    "games:dev": "npm run dev -w @bingo/games-provider",
    "games:build": "npm run build -w @bingo/games-provider",
    "games:test": "npm run test -w @bingo/games-provider",
    "games:typecheck": "npm run typecheck -w @bingo/games-provider",
    "games:smoke": "node --import tsx apps/games-provider/scripts/smoke.ts",
    "typecheck": "npm run typecheck -w @bingo/api && npm run typecheck -w @bingo/web && npm run typecheck -w @bingo/games-provider",
    "db:validate": "prisma validate --schema apps/api/prisma/schema.prisma",
    "db:format": "prisma format --schema apps/api/prisma/schema.prisma",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:constraints": "prisma db execute --file apps/api/prisma/sql/constraints.sql --schema apps/api/prisma/schema.prisma",
    "db:setup": "npm run db:migrate && npm run db:constraints && npm run db:generate",
    "db:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "api:worker": "npm run worker -w @bingo/api",
    "api:bot": "npm run bot -w @bingo/api",
    "api:support-bot": "npm run support-bot -w @bingo/api",
    "admin:create": "npm run admin:create -w @bingo/api --",
    "db:seed": "npm run db:seed -w @bingo/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "prisma": "^6.16.0"
  }
}
