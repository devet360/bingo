# syntax=docker/dockerfile:1
# Worker-only image, used when a Procfile process type is not an option.
# Shares the API build; only the command differs.
FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
RUN npm ci

COPY apps/api apps/api
RUN npx prisma generate --schema apps/api/prisma/schema.prisma \
  && npm run build -w @bingo/api \
  && npm prune --omit=dev \
  && npx prisma generate --schema apps/api/prisma/schema.prisma \
  && npx prisma --version

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
# Whole workspace: dist plus any node_modules npm did not hoist to the root.
COPY --from=build /app/apps ./apps

CMD ["node", "apps/api/dist/worker.js"]
