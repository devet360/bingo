// ═══════════════════════════════════════════════════════════════════════════════
// Bingo Casino Platform — Canonical Data Model (Phase 1)
//
// MONEY
//   Every monetary column is BigInt minor units (1 credit = 100 minor units).
//   Never Float/Decimal for money. Wallet currency is platform credits.
//
// LEDGER
//   TransactionLedger is the immutable double-entry journal.
//   LedgerEntry.amount is SIGNED: +credit / -debit, and
//   SUM(amount) over one TransactionLedger MUST be exactly 0.
//   Wallet / AgentProfile / LedgerAccount balances are caches. They are written
//   only inside the same $transaction as the journal entries that justify them.
//
// BUSINESS ↔ LEDGER LINKS
//   Business tables do not carry ledger foreign keys. A TransactionLedger points
//   back via (refType, refId, kind); a partial unique index (see sql/constraints.sql)
//   guarantees at most one journal entry per business event per kind.
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════ ENUMS ════════════════════════════════════

enum UserRole {
  PLAYER
  AGENT
  SUPER_ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ClientPlatform {
  TELEGRAM_MINI_APP
  IOS
  ANDROID
  WEB
  AGENT_PORTAL
}

enum OtpChannel {
  SMS
  EMAIL
  TELEGRAM
}

enum OtpPurpose {
  LOGIN
  LINK_PHONE
  LINK_EMAIL
  PASSWORD_RESET
  WITHDRAWAL_CONFIRM
}

enum AgentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum AgentTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  CASH
  CARD
  CRYPTO
}

enum DepositStatus {
  PENDING // request created, waiting for an agent
  PROCESSING // agent claimed it, money not yet credited
  CREDITED // player wallet credited
  REJECTED
  CANCELLED
  EXPIRED
  DISPUTED
}

// How far a deposit's receipt has been checked. NOT_REQUIRED covers methods
// with no receipt (cash), MANUAL means a human must decide.
enum VerificationStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
  FAILED
  MANUAL
}

// Where the receipt body came from. Server is cheki's normal path; Client is
// a Telebirr/M-Pesa page fetched by the payer's own device (those hosts are
// unreachable from outside Ethiopia); Relay is an operator-run fetcher.
enum VerificationSource {
  SERVER
  CLIENT
  RELAY
}

enum WithdrawalStatus {
  ESCROWED // player funds locked, payout code issued
  PROCESSING // agent claimed the task and is paying out; commission withheld
  SETTLED // proof verified, escrow moved to agent float
  CANCELLED
  EXPIRED
  DISPUTED
}

// LedgerAccount.ownerKind determines which account codes are legal for it:
//   USER     -> AVAILABLE | ESCROW | LOCKED | BONUS
//   AGENT    -> FLOAT | FLOAT_ESCROW | COMMISSION
//   PLATFORM -> RAKE | COMMISSION_EXPENSE | TREASURY | SUSPENSE | BONUS_EXPENSE
enum AccountOwnerKind {
  USER
  AGENT
  PLATFORM
}

enum AccountCode {
  AVAILABLE
  ESCROW
  LOCKED
  BONUS // promotional credits: withdrawable only once wagering clears
  FLOAT
  FLOAT_ESCROW
  COMMISSION
  RAKE
  COMMISSION_EXPENSE
  BONUS_EXPENSE // promotional grants; carries a debit (negative) balance
  TREASURY
  SUSPENSE
}

enum LedgerKind {
  AGENT_FLOAT_TOP_UP
  AGENT_FLOAT_CASH_OUT
  AGENT_FLOAT_ADJUSTMENT
  DEPOSIT
  DEPOSIT_COMMISSION
  WITHDRAWAL_ESCROW
  WITHDRAWAL_HOLD // escrow -> agent FLOAT_ESCROW while the payout is proven
  WITHDRAWAL_HOLD_RELEASE // FLOAT_ESCROW -> agent FLOAT once proof is verified
  WITHDRAWAL_HOLD_REFUND // escrow returned to the player when the agent failed
  WITHDRAWAL_SETTLEMENT
  WITHDRAWAL_COMMISSION
  WITHDRAWAL_REFUND
  WITHDRAWAL_FEE
  CARD_PURCHASE
  ROUND_PAYOUT
  ROUND_REFUND
  BONUS_GRANT
  BONUS_CONVERT
  BONUS_FORFEIT
  AFFILIATE_COMMISSION
  PROVIDER_BET
  PROVIDER_WIN
  PROVIDER_ROLLBACK
  RAIN_CREDIT
  MANUAL_ADJUSTMENT
}

enum CommissionKind {
  DEPOSIT
  WITHDRAWAL
}

enum FloatRequestDirection {
  TOP_UP // agent wires money to platform, float increases
  CASH_OUT // agent withdraws earned float to bank/mobile money
}

enum FloatRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Routing assignment for one deposit or withdrawal. A partial unique index in
// sql/constraints.sql allows at most one OFFERED/CLAIMED task per agent, which
// is the single-task lock: an agent never holds two payouts at once.
enum AgentTaskStatus {
  OFFERED // pushed to the agent, not yet accepted
  CLAIMED // agent owns the request and is working it
  COMPLETED
  CANCELLED // reassigned to another agent or the request was cancelled
  EXPIRED // SLA elapsed without completion
}

enum BingoVariant {
  US_75
  UK_90
}

// MAIN mirrors the Ethiopian long game (bingo1020): pre-registration, many
// cards, manual BINGO presses, advertised fixed prizes and a runner-up round.
// FAST is the mini quick game: one card per player, auto-daub, pool prize.
enum RoomMode {
  MAIN
  FAST
}

enum ClaimPhase {
  MAIN
  RUNNER_UP
}

enum WinPattern {
  HORIZONTAL
  VERTICAL
  DIAGONAL
  FOUR_CORNERS
  FULL_HOUSE
}

enum RoomStatus {
  OPEN
  MAINTENANCE
  CLOSED
}

enum RoundStatus {
  WAITING // countdown, cards on sale
  LOCKED // final seconds, sales closed
  PLAYING // balls being drawn
  CLAIM_VERIFICATION // main claims being validated, draw paused
  RUNNER_UP // runner-up window after the main winner
  COMPLETED // paid out and archived
  CANCELLED // round aborted, all stakes refunded
}

enum CardStatus {
  PENDING // added for viewing, not paid for yet
  ACTIVE
  WON
  LOST
  REFUNDED
  BLOCKED // false BINGO press in the main game
}

enum ClaimStatus {
  PENDING
  VALID
  INVALID
  PAID
}

enum NotificationType {
  DEPOSIT_CREDITED
  DEPOSIT_REJECTED
  WITHDRAWAL_SETTLED
  WITHDRAWAL_PROCESSING
  WITHDRAWAL_REFUNDED
  WITHDRAWAL_EXPIRED
  COMMISSION_PAID
  ROUND_RESULT
  AGENT_ALERT
  SUPPORT_MESSAGE // a player is waiting in the support chat (staff only)
  SYSTEM
}

// Support chat opened from the support bot. OPEN = staff should answer,
// PENDING = waiting for the player, RESOLVED/CLOSED are terminal.
enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum SupportTopic {
  DEPOSIT
  WITHDRAWAL
  ACCOUNT
  PAYMENTS
  OTHER
}

enum SupportMessageAuthor {
  PLAYER
  STAFF
  BOT
  SYSTEM
}

// ═══════════════════════════════ IDENTITY & ACCESS ════════════════════════════

model User {
  id                    String     @id @default(uuid()) @db.Uuid
  // Telegram is the primary identity for the Mini App. Null for phone-only users.
  telegramId            BigInt?    @unique
  telegramUsername      String?
  phone                 String?    @unique
  // Set only when the number arrived via the Telegram bot's contact share, which
  // is the sole signup path for players.
  phoneVerifiedAt       DateTime?
  email                 String?    @unique
  passwordHash          String?
  mustChangePassword    Boolean    @default(false)
  displayName           String
  avatarUrl             String?
  locale                String     @default("en")
  countryCode           String?
  role                  UserRole   @default(PLAYER)
  status                UserStatus @default(ACTIVE)
  kycStatus             KycStatus  @default(UNVERIFIED)
  kycReviewedAt         DateTime?
  referralCode          String     @unique
  referredById          String?    @db.Uuid
  // One-time token the staff dashboard puts in a t.me/<bot>?start=staff_<token>
  // link, so a staff member can attach their own Telegram account without the
  // super admin knowing their numeric id.
  telegramLinkToken     String?    @unique
  telegramLinkExpiresAt DateTime?
  lastLoginAt           DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  referredBy            User?                 @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals             User[]                @relation("UserReferrals")
  wallet                Wallet?
  agentProfile          AgentProfile?
  sessions              AuthSession[]
  bingoCards            BingoCard[]
  bingoClaims           BingoClaim[]
  roundWins             RoundWinner[]
  ratingsGiven          AgentRating[]         @relation("RatingAuthor")
  notifications         Notification[]
  auditLogs             AuditLog[]            @relation("AuditActor")
  ledgersCreated        TransactionLedger[]   @relation("LedgerCreator")
  depositsAsPlayer      DepositRequest[]      @relation("DepositPlayer")
  depositsProcessed     DepositRequest[]      @relation("DepositProcessor")
  withdrawalsAsPlayer   WithdrawalRequest[]   @relation("WithdrawalPlayer")
  withdrawalsProcessed  WithdrawalRequest[]   @relation("WithdrawalProcessor")
  floatRequestsReviewed AgentFloatRequest[]   @relation("FloatReviewer")
  bonuses               Bonus[]               @relation("BonusOwner")
  bonusesGranted        Bonus[]               @relation("BonusGrantor")
  referralCommissions   ReferralCommission[]  @relation("ReferralCommissions")
  referralPlays         ReferralCommission[]  @relation("ReferralPlayer")
  providerSessions      ProviderSession[]
  providerTransactions  ProviderTransaction[] @relation("ProviderTransactions")
  payoutAccounts        PlayerPayoutAccount[]
  mediaAssets           MediaAsset[]          @relation("MediaUploader")
  proofsSubmitted       WithdrawalProof[]     @relation("ProofSubmitter")
  proofsReviewed        WithdrawalProof[]     @relation("ProofReviewer")
  supportTickets        SupportTicket[]       @relation("SupportTickets")
  supportAssigned       SupportTicket[]       @relation("SupportAssignee")
  supportMessages       SupportMessage[]      @relation("SupportMessageAuthor")

  @@index([role, status])
  @@index([createdAt])
}

// One row per issued refresh token. Rotating refresh tokens revoke the old row.
model AuthSession {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  refreshTokenHash String         @unique
  platform         ClientPlatform
  deviceId         String?
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime       @default(now())
  createdAt        DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// Hashed OTP codes for phone/email login and account linking. Never store plaintext.
model OtpCode {
  id          String     @id @default(uuid()) @db.Uuid
  identifier  String // E.164 phone or lowercased email
  channel     OtpChannel
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  ip          String?
  createdAt   DateTime   @default(now())

  @@index([identifier, purpose, createdAt])
}

// ═══════════════════════════════ AGENT NETWORK ════════════════════════════════

model AgentProfile {
  id                      String      @id @default(uuid()) @db.Uuid
  userId                  String      @unique @db.Uuid
  agentCode               String      @unique // public code shown in the player app
  status                  AgentStatus @default(PENDING)
  tier                    AgentTier   @default(BRONZE)
  region                  String
  city                    String?
  district                String?
  isOnline                Boolean     @default(false)
  // Agent-controlled availability switch. ACTIVE + isOnline + acceptingTasks
  // are all required before the routing engine will offer new work.
  acceptingTasks          Boolean     @default(true)
  lastSeenAt              DateTime?
  ratingAvg               Decimal     @default(0) @db.Decimal(3, 2)
  ratingCount             Int         @default(0)
  completedDeposits       Int         @default(0)
  completedWithdrawals    Int         @default(0)
  depositCommissionBps    Int         @default(300) // 3.00%
  withdrawalCommissionBps Int         @default(200) // 2.00%
  perTxnLimit             BigInt?
  dailyDepositLimit       BigInt?
  dailyWithdrawalLimit    BigInt?
  // Semi-automated deposits: when enabled, a deposit assigned to this agent
  // whose receipt verifies and whose amount is <= autoDepositThreshold is
  // credited without the agent pressing Credit. Anything above, or anything
  // that fails to verify, stays in the manual queue.
  autoDepositEnabled      Boolean     @default(false)
  autoDepositThreshold    BigInt?
  // Denormalised caches of the AGENT ledger accounts. Rebuildable from the journal.
  floatAvailable          BigInt      @default(0)
  floatEscrow             BigInt      @default(0) // float locked by pending cash-out
  commissionEarned        BigInt      @default(0)
  version                 Int         @default(0) // optimistic lock, bumped on every balance write
  internalNote            String?
  approvedById            String?     @db.Uuid
  approvedAt              DateTime?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccounts AgentPaymentAccount[]
  deposits        DepositRequest[]
  withdrawals     WithdrawalRequest[]
  commissions     AgentCommission[]
  ratings         AgentRating[]
  floatRequests   AgentFloatRequest[]
  tasks           AgentTask[]
  proofs          WithdrawalProof[]

  @@index([status, isOnline, region])
  @@index([tier, status])
}

// Payment rails an agent accepts for deposits / pays out on withdrawals.
model AgentPaymentAccount {
  id             String        @id @default(uuid()) @db.Uuid
  agentProfileId String        @db.Uuid
  method         PaymentMethod
  provider       String? // "MTN MoMo", "Airtel Money", "GTBank", ...
  accountName    String
  accountNumber  String
  instructions   String?
  minAmount      BigInt?
  maxAmount      BigInt?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  agentProfile AgentProfile        @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  deposits     DepositRequest[]
  withdrawals  WithdrawalRequest[]

  @@unique([agentProfileId, method, accountNumber])
  @@index([agentProfileId, isActive])
}

model AgentRating {
  id             String   @id @default(uuid()) @db.Uuid
  agentProfileId String   @db.Uuid
  authorId       String   @db.Uuid
  depositId      String?  @unique @db.Uuid
  score          Int // 1..5, CHECK enforced in SQL
  comment        String?
  createdAt      DateTime @default(now())

  agentProfile AgentProfile    @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)
  author       User            @relation("RatingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  deposit      DepositRequest? @relation(fields: [depositId], references: [id], onDelete: SetNull)

  @@index([agentProfileId, createdAt])
}

// Agent ↔ SuperAdmin cash settlement (wire in / wire out of float).
model AgentFloatRequest {
  id             String                @id @default(uuid()) @db.Uuid
  idempotencyKey String                @unique
  agentProfileId String                @db.Uuid
  direction      FloatRequestDirection
  amount         BigInt
  method         PaymentMethod
  externalRef    String? // bank/UTR/tx hash
  proofUrl       String?
  status         FloatRequestStatus    @default(PENDING)
  reviewedById   String?               @db.Uuid
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  agentProfile AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Restrict)
  reviewedBy   User?        @relation("FloatReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([agentProfileId, createdAt])
}

// One row per routed deposit or withdrawal. Exactly one of depositId /
// withdrawalId is set (CHECK in sql/constraints.sql). Reassignment keeps the
// row and swaps the agent, bumping reassignCount, so the SLA history is intact.
model AgentTask {
  id             String          @id @default(uuid()) @db.Uuid
  agentProfileId String          @db.Uuid
  depositId      String?         @unique @db.Uuid
  withdrawalId   String?         @unique @db.Uuid
  status         AgentTaskStatus @default(CLAIMED)
  slaDeadline    DateTime?
  assignedAt     DateTime        @default(now())
  claimedAt      DateTime?
  completedAt    DateTime?
  reassignCount  Int             @default(0)
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  agentProfile AgentProfile       @relation(fields: [agentProfileId], references: [id], onDelete: Restrict)
  deposit      DepositRequest?    @relation(fields: [depositId], references: [id], onDelete: Cascade)
  withdrawal   WithdrawalRequest? @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([agentProfileId, status])
  @@index([status, slaDeadline])
}

// Chart of accounts. Balance is a cache: SUM of its journal entries.
// Negative balances are only legal on the platform bridge/expense accounts
// (SUSPENSE, COMMISSION_EXPENSE); every other account must stay >= 0.
model LedgerAccount {
  id        String           @id @default(uuid()) @db.Uuid
  ownerKind AccountOwnerKind
  ownerId   String // user/agent UUID, or "platform" for platform accounts
  code      AccountCode
  balance   BigInt           @default(0)
  version   Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  entries LedgerEntry[]

  @@unique([ownerKind, ownerId, code])
  @@index([code])
}

// The journal header. idempotencyKey makes every financial command replay-safe:
// a retried HTTP request or a redelivered BullMQ job cannot post twice.
model TransactionLedger {
  id             String     @id @default(uuid()) @db.Uuid
  idempotencyKey String     @unique
  kind           LedgerKind
  refType        String? // "DepositRequest" | "WithdrawalRequest" | "BingoRound" | ...
  refId          String?
  memo           String?
  createdById    String?    @db.Uuid
  createdAt      DateTime   @default(now())

  entries   LedgerEntry[]
  createdBy User?         @relation("LedgerCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([refType, refId])
  @@index([createdAt])
}

// Append-only journal line. amount is signed; balanceAfter snapshots the account.
// UPDATE and DELETE are blocked by a trigger (sql/constraints.sql).
model LedgerEntry {
  id           BigInt   @id @default(autoincrement())
  ledgerId     String   @db.Uuid
  accountId    String   @db.Uuid
  amount       BigInt // +credit / -debit, never 0
  balanceAfter BigInt
  createdAt    DateTime @default(now())

  ledger  TransactionLedger @relation(fields: [ledgerId], references: [id], onDelete: Restrict)
  account LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  // One net movement per account per journal entry.
  @@unique([ledgerId, accountId])
  @@index([accountId, id])
}

// Commission actually paid to an agent, per settled transaction. Reporting mirror
// of the DEPOSIT_COMMISSION / WITHDRAWAL_COMMISSION journal entries.
model AgentCommission {
  id             String         @id @default(uuid()) @db.Uuid
  agentProfileId String         @db.Uuid
  kind           CommissionKind
  depositId      String?        @unique @db.Uuid
  withdrawalId   String?        @unique @db.Uuid
  baseAmount     BigInt // amount the bps were applied to
  bps            Int
  amount         BigInt
  createdAt      DateTime       @default(now())

  agentProfile AgentProfile       @relation(fields: [agentProfileId], references: [id], onDelete: Restrict)
  deposit      DepositRequest?    @relation(fields: [depositId], references: [id], onDelete: Restrict)
  withdrawal   WithdrawalRequest? @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)

  @@index([agentProfileId, createdAt])
}

// Default commission per tier/method; AgentProfile columns override when set.
model CommissionRule {
  id            String        @id @default(uuid()) @db.Uuid
  tier          AgentTier
  method        PaymentMethod
  depositBps    Int           @default(300)
  withdrawalBps Int           @default(200)
  minAmount     BigInt?
  maxAmount     BigInt?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([tier, method])
}

// ═════════════════════════════ PLAYER WALLET ══════════════════════════════════

// Playable funds only. Agent float lives on AgentProfile, never here.
model Wallet {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  available         BigInt   @default(0)
  escrow            BigInt   @default(0) // withdrawal escrow
  locked            BigInt   @default(0) // staked in an active bingo round
  bonus             BigInt   @default(0) // promotional credits awaiting wagering
  lifetimeDeposited BigInt   @default(0)
  lifetimeWithdrawn BigInt   @default(0)
  lifetimeWagered   BigInt   @default(0)
  lifetimeWon       BigInt   @default(0)
  version           Int      @default(0) // optimistic lock / audit
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════ AGENT-ASSISTED MONEY MOVEMENT ════════════════════════

// Admin-configured deposit rails. `code` selects the parser implementation in
// services/receipts/parsers; the endpoint template and limits are editable so a
// bank changing host or a new minimum does not need a deploy. A provider with
// no parser (or supported = false) can still be offered for manual deposits.
model DepositProvider {
  code            String        @id // "telebirr", "cbe", "boa", ...
  name            String
  method          PaymentMethod
  // Parser implementation in services/receipts/parsers (null = manual only).
  parser          String?
  // URL template with {ref}, {account} and {phone}. Null = manual only.
  endpoint        String?
  // Regex source a reference must match (anchored, no flags).
  refPattern      String?
  refHint         String?
  accountDigits   Int? // last N digits of the receiving account, when required
  requiresPhone   Boolean       @default(false)
  // The reference is a lookup token, not printed on the receipt (Awash, Bunna,
  // ZamZam, eBirr, CBE receipt ids): skip the reference-equality gate.
  opaqueReference Boolean       @default(false)
  // Telebirr and M-Pesa receipt hosts reject connections from outside
  // Ethiopia: the payer's device may fetch the page and submit it back.
  clientSide      Boolean       @default(false)
  // Whether cheki has a parser for `code`. Admin may enable/disable a
  // supported provider but cannot make an unsupported one auto-verify.
  supported       Boolean       @default(false)
  enabled         Boolean       @default(false)
  sortOrder       Int           @default(0)
  instructions    String?
  minAmount       BigInt?
  maxAmount       BigInt?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  deposits      DepositRequest[]
  verifications ReceiptVerification[]

  @@index([enabled, method, sortOrder])
}

model DepositRequest {
  id                  String              @id @default(uuid()) @db.Uuid
  // 6-digit code the player shows the agent. Unique only among open requests
  // (partial index in sql/constraints.sql) so the 1M namespace can be recycled.
  code                String
  idempotencyKey      String              @unique
  playerId            String              @db.Uuid
  agentProfileId      String?             @db.Uuid // null = open to any online agent
  paymentAccountId    String?             @db.Uuid
  method              PaymentMethod
  amount              BigInt
  creditedAmount      BigInt?
  status              DepositStatus       @default(PENDING)
  receiptUrl          String?
  externalRef         String? // MoMo/bank reference typed by the player
  // Provider + receipt reference when the deposit is to be verified
  // automatically against the bank's receipt page.
  providerCode        String?
  receiptReference    String?
  // Extra inputs some banks need to look the receipt up (BOA: last 5 digits of
  // an account; CBE Birr: the payer phone). Kept only until verification.
  receiptAccount      String?
  receiptPhone        String?
  verificationStatus  VerificationStatus  @default(NOT_REQUIRED)
  verificationMessage String?
  verificationSource  VerificationSource?
  autoVerified        Boolean             @default(false)
  verifiedAt          DateTime?
  playerNote          String?
  agentNote           String?
  processedById       String?             @db.Uuid
  expiresAt           DateTime
  claimedAt           DateTime? // agent opened/claimed the request
  settledAt           DateTime? // wallet credited
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  player         User                 @relation("DepositPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  agentProfile   AgentProfile?        @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)
  paymentAccount AgentPaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  processedBy    User?                @relation("DepositProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  provider       DepositProvider?     @relation(fields: [providerCode], references: [code], onDelete: SetNull)
  verification   ReceiptVerification?
  commission     AgentCommission?
  rating         AgentRating?
  task           AgentTask?

  @@index([agentProfileId, status, createdAt])
  @@index([playerId, status])
  @@index([status, expiresAt])
  @@index([code])
  @@index([providerCode, receiptReference])
}

// One row per (provider, receipt reference) ever seen. The unique key is the
// anti-replay guard: the same bank receipt can only move money once, and the
// row keeps the parse result for audit and disputes. Values are snapshots; the
// deposit's own columns win once an agent edits it.
model ReceiptVerification {
  id                String              @id @default(uuid()) @db.Uuid
  providerCode      String
  reference         String
  depositId         String?             @unique @db.Uuid
  status            VerificationStatus  @default(PENDING)
  source            VerificationSource?
  amount            BigInt?
  currency          String?
  senderName        String?
  senderAccount     String?
  receiverName      String?
  receiverAccount   String?
  transactionDate   String?
  transactionStatus String?
  message           String?
  detail            Json?
  attempts          Int                 @default(0)
  verifiedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  provider DepositProvider @relation(fields: [providerCode], references: [code], onDelete: Restrict)
  deposit  DepositRequest? @relation(fields: [depositId], references: [id], onDelete: SetNull)

  @@unique([providerCode, reference])
  @@index([status, createdAt])
}

model WithdrawalRequest {
  id               String           @id @default(uuid()) @db.Uuid
  // Bearer code the agent types to release escrow. Unique among live requests only,
  // so codes are recyclable once a request settles or expires.
  payoutCode       String
  idempotencyKey   String           @unique
  playerId         String           @db.Uuid
  agentProfileId   String?          @db.Uuid // null = any active agent may settle it
  paymentAccountId String?          @db.Uuid // agent's paying account
  // Player's destination account. Required for automated proof checks; cash
  // payouts still need a screenshot and a manual decision.
  payoutAccountId  String?          @db.Uuid
  method           PaymentMethod
  amount           BigInt // gross, debited from player
  fee              BigInt           @default(0)
  netAmount        BigInt // amount the agent hands over in cash
  status           WithdrawalStatus @default(ESCROWED)
  playerNote       String?
  agentNote        String?
  processedById    String?          @db.Uuid
  proofRequired    Boolean          @default(true)
  expiresAt        DateTime
  holdAt           DateTime? // escrow moved to agent FLOAT_ESCROW
  settledAt        DateTime? // proof verified, agent float released
  cancelledAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  player         User                 @relation("WithdrawalPlayer", fields: [playerId], references: [id], onDelete: Restrict)
  agentProfile   AgentProfile?        @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)
  paymentAccount AgentPaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  payoutAccount  PlayerPayoutAccount? @relation(fields: [payoutAccountId], references: [id], onDelete: SetNull)
  processedBy    User?                @relation("WithdrawalProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  commission     AgentCommission?
  proofs         WithdrawalProof[]
  task           AgentTask?

  @@index([agentProfileId, status, createdAt])
  @@index([playerId, status])
  @@index([status, expiresAt])
  @@index([payoutCode])
}

// A player's own payout destination (mobile-money wallet, bank account...).
// Agents pay into this; proofs are cross-checked against its digits.
model PlayerPayoutAccount {
  id            String        @id @default(uuid()) @db.Uuid
  playerId      String        @db.Uuid
  method        PaymentMethod
  provider      String? // "Telebirr", "CBE", "Awash", ...
  accountName   String
  accountNumber String
  isDefault     Boolean       @default(false)
  isActive      Boolean       @default(true)
  verifiedAt    DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  player      User                @relation(fields: [playerId], references: [id], onDelete: Cascade)
  withdrawals WithdrawalRequest[]

  @@unique([playerId, method, accountNumber])
  @@index([playerId, isActive])
}

// Uploaded evidence (payment screenshots). Bytes live on the media volume;
// the row keeps the digest so the same file cannot be attached twice.
model MediaAsset {
  id           String   @id @default(uuid()) @db.Uuid
  sha256       String   @unique
  storageKey   String   @unique
  mimeType     String
  byteSize     Int
  originalName String?
  purpose      String   @default("proof")
  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  uploadedBy      User?             @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  proofs          WithdrawalProof[]
  supportMessages SupportMessage[]

  @@index([uploadedById, createdAt])
}

// Payment evidence for one withdrawal. Agents append a row per attempt; the
// newest row decides the request. `status` reuses VerificationStatus so an
// automated check, a manual review and a rejection share one vocabulary.
model WithdrawalProof {
  id              String             @id @default(uuid()) @db.Uuid
  withdrawalId    String             @db.Uuid
  agentProfileId  String?            @db.Uuid
  submittedById   String?            @db.Uuid
  method          PaymentMethod
  reference       String?
  paidAmount      BigInt?
  currency        String             @default("ETB")
  senderAccount   String? // agent's paying account, as shown on the receipt
  receiverAccount String? // player's destination, as shown on the receipt
  paidAt          DateTime?
  mediaAssetId    String?            @db.Uuid
  notes           String?
  status          VerificationStatus @default(PENDING)
  message         String?
  reviewedById    String?            @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  withdrawal   WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  agentProfile AgentProfile?     @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)
  submittedBy  User?             @relation("ProofSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy   User?             @relation("ProofReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  mediaAsset   MediaAsset?       @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([withdrawalId, createdAt])
  @@index([status, createdAt])
  @@index([reference])
}

// ═══════════════════════════════ BINGO ENGINE ═════════════════════════════════

model BingoRoom {
  id                 String       @id @default(uuid()) @db.Uuid
  code               String       @unique // "us75-10", "uk90-500"
  name               String
  variant            BingoVariant
  mode               RoomMode     @default(FAST)
  stakePerCard       BigInt
  maxCardsPerPlayer  Int          @default(4)
  minPlayersToStart  Int          @default(1)
  rakeBps            Int          @default(1000) // 10.00%
  allowedPatterns    WinPattern[]
  status             RoomStatus   @default(OPEN)
  purchaseWindowSecs Int          @default(15)
  lockWindowSecs     Int          @default(5)
  drawIntervalMs     Int          @default(3500)
  claimWindowSecs    Int          @default(20)
  autoDaubEnabled    Boolean      @default(true)
  // MAIN mode: advertised guarantees. fixedPrize is split by the main winners,
  // runnerUpPrize by the runner-up winners. Snapshot onto each round.
  fixedPrize         BigInt?
  runnerUpEnabled    Boolean      @default(false)
  runnerUpPrize      BigInt?
  runnerUpWindowSecs Int          @default(60)
  pressWindowSecs    Int          @default(60)
  // When false the player UI hides the auto BINGO press option; presses stay manual.
  allowAutoBingoPress Boolean     @default(false)
  // [{ minCards: 5, bonusCards: 1 }, ...] free registrations by cards registered.
  bonusTiers         Json         @default("[]")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  rounds BingoRound[]

  @@index([status, variant])
}

// One row per round. The seed commitment is published while the round is WAITING;
// serverSeed is revealed only once the round is COMPLETED.
model BingoRound {
  id               String       @id @default(uuid()) @db.Uuid
  roomId           String       @db.Uuid
  roundNumber      Int
  status           RoundStatus  @default(WAITING)
  // Room economics are snapshotted per round: editing a room never rewrites an
  // in-flight or historical round.
  variant          BingoVariant
  mode             RoomMode     @default(FAST)
  stakePerCard     BigInt
  rakeBps          Int
  allowedPatterns  WinPattern[]
  fixedPrize       BigInt?
  runnerUpEnabled  Boolean      @default(false)
  runnerUpPrize    BigInt?
  runnerUpNumber   Int?
  runnerUpOpensAt  DateTime?
  runnerUpClosesAt DateTime?
  bonusCards       Int          @default(0)
  serverSeed       String // secret until reveal
  serverSeedHash   String // published in advance (sha256(serverSeed))
  clientSeed       String? // aggregated player contributions, hashed
  clientSeedCount  Int          @default(0)
  nonce            Int          @default(0)
  rngVersion       String       @default("hmac-sha256-fisher-yates-v1")
  ballOrder        Int[]        @default([]) // full shuffled pool (75 or 90 balls)
  drawnBalls       Int[]        @default([]) // prefix of ballOrder
  currentBall      Int?
  cardsSold        Int          @default(0)
  uniquePlayers    Int          @default(0)
  grossPot         BigInt       @default(0)
  rakeAmount       BigInt       @default(0)
  prizePool        BigInt       @default(0)
  winningPattern   WinPattern?
  claimsOpenAt     DateTime?
  claimsCloseAt    DateTime?
  // Sales close at purchaseClosesAt; the engine extends it while a round is
  // under-filled. lastDrawAt makes the draw cadence recoverable after restart.
  purchaseClosesAt DateTime?
  startedAt        DateTime?
  lastDrawAt       DateTime?
  completedAt      DateTime?
  seedRevealedAt   DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  room    BingoRoom     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  cards   BingoCard[]
  claims  BingoClaim[]
  winners RoundWinner[]

  @@unique([roomId, roundNumber])
  @@index([status, createdAt])
}

model BingoCard {
  id             String       @id @default(uuid()) @db.Uuid
  roundId        String       @db.Uuid
  userId         String       @db.Uuid
  cardIndex      Int // 0..3 within the player's purchase
  stake          BigInt
  variant        BingoVariant
  // Variant-shaped matrix. US_75: 5x5 with FREE centre. UK_90: 3x9 with 15 numbers.
  cells          Json
  markedNumbers  Int[]        @default([])
  autoDaub       Boolean      @default(false)
  isBonus        Boolean      @default(false)
  // Player opted into automatic BINGO presses; only honoured when the room allows it.
  autoPress      Boolean      @default(false)
  // Player entropy folded into the round's aggregate clientSeed at lock time.
  clientSeed     String?
  // Per-request idempotency: a retried purchase returns these cards, never new ones.
  idempotencyKey String?      @unique
  status         CardStatus   @default(ACTIVE)
  wonPattern     WinPattern?
  purchasedAt    DateTime     @default(now())

  round  BingoRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  claims BingoClaim[]
  win    RoundWinner?

  @@unique([roundId, userId, cardIndex])
  @@index([roundId, status])
  @@index([userId, purchasedAt])
}

model BingoClaim {
  id              String      @id @default(uuid()) @db.Uuid
  roundId         String      @db.Uuid
  cardId          String      @db.Uuid
  userId          String      @db.Uuid
  pattern         WinPattern
  phase           ClaimPhase  @default(MAIN)
  status          ClaimStatus @default(PENDING)
  drawnSnapshot   Int[] // balls drawn when the claim landed: audit evidence
  rejectionReason String?
  claimedAt       DateTime    @default(now())
  validatedAt     DateTime?

  round BingoRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  card  BingoCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([roundId, status])
  @@index([cardId])
}

model RoundWinner {
  id         String     @id @default(uuid()) @db.Uuid
  roundId    String     @db.Uuid
  cardId     String     @unique @db.Uuid
  userId     String     @db.Uuid
  pattern    WinPattern
  phase      ClaimPhase @default(MAIN)
  payout     BigInt
  isSplitPot Boolean    @default(false)
  createdAt  DateTime   @default(now())

  round BingoRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  card  BingoCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([roundId])
}

// ═══════════════════════════════ PLATFORM OPS ═════════════════════════════════

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  title          String
  body           String
  data           Json?
  readAt         DateTime?
  // Set once the bot has pushed this notification to Telegram, so the worker
  // sweep can retry without double-sending.
  telegramSentAt DateTime?
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([createdAt])
  @@index([telegramSentAt, createdAt])
}

// One support conversation. The support bot reuses the player's OPEN/PENDING
// ticket instead of opening another; a partial unique index backs that rule.
model SupportTicket {
  id                  String              @id @default(uuid()) @db.Uuid
  code                String              @unique // short code staff can read out
  playerId            String              @db.Uuid
  // Private chat the support bot delivers staff replies to. Snapshot, so the
  // thread stays routable even if the account is edited later.
  telegramChatId      BigInt
  topic               SupportTopic        @default(OTHER)
  status              SupportTicketStatus @default(OPEN)
  locale              String              @default("en")
  subject             String              @default("Support request")
  assigneeId          String?             @db.Uuid
  claimedAt           DateTime?
  resolvedAt          DateTime?
  // Badge counters for the staff queue and the player's "unread" hint.
  unreadForStaff      Int                 @default(0)
  unreadForPlayer     Int                 @default(0)
  lastMessageAt       DateTime            @default(now())
  lastPlayerMessageAt DateTime?
  lastStaffMessageAt  DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  player   User             @relation("SupportTickets", fields: [playerId], references: [id], onDelete: Cascade)
  assignee User?            @relation("SupportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([status, lastMessageAt])
  @@index([playerId, lastMessageAt])
  @@index([assigneeId, status])
}

// Append-only chat transcript. Inbound rows come from the support bot; staff
// replies are written by the API and delivered over the Bot API.
model SupportMessage {
  id                String               @id @default(uuid()) @db.Uuid
  ticketId          String               @db.Uuid
  author            SupportMessageAuthor
  authorUserId      String?              @db.Uuid
  body              String
  mediaAssetId      String?              @db.Uuid
  telegramMessageId BigInt?
  // Staff replies are queued here and pushed by the support bot. Attempts stop
  // at 5 so a blocked bot does not retry forever.
  deliveredAt       DateTime?
  deliveryAttempts  Int                  @default(0)
  deliveryError     String?
  createdAt         DateTime             @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser User?         @relation("SupportMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  mediaAsset MediaAsset?   @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([authorUserId, createdAt])
}

model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorId    String?   @db.Uuid
  actorRole  UserRole?
  action     String // "deposit.credit", "agent.suspend", "config.update", ...
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model SystemConfig {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}

// ═══════════════════════════════ MARKETING ════════════════════════════════════

enum CampaignKind {
  BANNER // slim strip pinned under the header
  POPUP // modal shown once per player per dismissHours window
}

enum CampaignAudience {
  ALL
  PLAYERS
  AGENTS
}

// Operator-authored announcement / promo surface. Content lives here rather than
// in SystemConfig so scheduling history and audience targeting stay queryable.
model Campaign {
  id           String           @id @default(uuid()) @db.Uuid
  kind         CampaignKind
  audience     CampaignAudience @default(ALL)
  // Locale-independent defaults; locale variants can be added per row.
  locale       String           @default("en")
  title        String
  body         String
  imageUrl     String?
  linkUrl      String?
  linkLabel    String?
  enabled      Boolean          @default(true)
  priority     Int              @default(0)
  // POPUP only: how long a dismissal is honoured before it shows again.
  dismissHours Int              @default(24)
  startsAt     DateTime?
  endsAt       DateTime?
  createdById  String?          @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([enabled, kind, startsAt, endsAt])
}

// ═════════════════════════════ BONUS & WAGERING ═══════════════════════════════

enum BonusKind {
  PROMO_CODE // player redeems a published code
  ADMIN_GRANT // staff grants directly to one player
}

enum BonusStatus {
  ACTIVE // wagering in progress
  COMPLETED // target met, bonus converted to withdrawable credits
  EXPIRED // deadline passed with wagering unmet, remainder forfeited
  CANCELLED
}

// Admin-defined promo code. `exchangeRateBps`-style percentage bonuses are
// expressed in basis points so no Float money math is ever involved.
model BonusPromotion {
  id                 String    @id @default(uuid()) @db.Uuid
  code               String    @unique
  name               String
  // Exactly one of percentBps / fixedAmount is set. percentBps applies to the
  // amount the player has deposited since the code was issued.
  percentBps         Int?
  fixedAmount        BigInt?
  maxBonus           BigInt?
  minDeposit         BigInt?
  // Required playthrough = granted bonus * wageringMultiplier.
  wageringMultiplier Int       @default(3)
  expiresInDays      Int       @default(7)
  enabled            Boolean   @default(true)
  startsAt           DateTime?
  endsAt             DateTime?
  maxRedemptions     Int?
  redemptionCount    Int       @default(0)
  createdById        String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bonuses Bonus[]

  @@index([enabled, startsAt, endsAt])
}

// One row per granted bonus. Only one ACTIVE bonus per user is enforced in the
// service layer; multiple historical rows stay for audit.
model Bonus {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  promotionId String?     @db.Uuid
  grantedById String?     @db.Uuid
  kind        BonusKind   @default(PROMO_CODE)
  amount      BigInt
  wagered     BigInt      @default(0)
  target      BigInt // amount * wageringMultiplier at grant time
  multiplier  Int
  status      BonusStatus @default(ACTIVE)
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user      User            @relation("BonusOwner", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?           @relation("BonusGrantor", fields: [grantedById], references: [id], onDelete: SetNull)
  promotion BonusPromotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([promotionId])
}

// ══════════════════════════ AFFILIATE / REFERRALS ═════════════════════════════

// Commission paid to a referrer out of the platform rake from a referred
// player's staked round. Unique per (referrer, round) so a retried settlement
// cannot pay twice.
model ReferralCommission {
  id         String   @id @default(uuid()) @db.Uuid
  referrerId String   @db.Uuid
  playerId   String   @db.Uuid
  roundId    String?  @db.Uuid
  rakeBase   BigInt // rake the bps were applied to
  bps        Int
  amount     BigInt
  createdAt  DateTime @default(now())

  referrer User @relation("ReferralCommissions", fields: [referrerId], references: [id], onDelete: Cascade)
  player   User @relation("ReferralPlayer", fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([referrerId, playerId, roundId])
  @@index([referrerId, createdAt])
}

// ═══════════════════════════ EXTERNAL GAME PROVIDERS ══════════════════════════

enum ProviderKind {
  NATIVE // first-party games served by this platform's engine
  AGGREGATOR // third-party aggregator exposing many games
}

enum ProviderSessionStatus {
  OPEN
  CLOSED
  EXPIRED
}

enum ProviderCallbackType {
  BET
  WIN
  ROLLBACK
  BALANCE
}

enum ProviderTransactionStatus {
  APPLIED
  REJECTED
  ROLLED_BACK
}

// Registered games provider. Wallet movements for AGGREGATOR games arrive on a
// signed callback; `webhookSecret` is rotated from the admin console and never
// returned by the API.
model GameProvider {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique
  name          String
  kind          ProviderKind @default(AGGREGATOR)
  apiBaseUrl    String?
  webhookSecret String?
  // ISO-4217 code this provider settles in. Callbacks in any other currency
  // are rejected instead of silently credited.
  currency      String       @default("ETB")
  // Operator-wide single-win ceiling in minor units; ProviderGame.maxWin wins.
  maxWin        BigInt?
  enabled       Boolean      @default(false)
  sortOrder     Int          @default(0)
  config        Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  games        ProviderGame[]
  sessions     ProviderSession[]
  callbackLogs ProviderCallbackLog[]
  transactions ProviderTransaction[]

  @@index([enabled, sortOrder])
}

model ProviderGame {
  id                String   @id @default(uuid()) @db.Uuid
  providerId        String   @db.Uuid
  externalId        String
  name              String
  category          String?
  thumbnailUrl      String?
  launchUrlTemplate String? // {token}, {lang}, {currency} placeholders
  minStake          BigInt?
  maxStake          BigInt?
  // Per-game single-win ceiling in minor units. Null falls back to the
  // provider cap, then to SystemConfig.
  maxWin            BigInt?
  enabled           Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  provider GameProvider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  sessions ProviderSession[]

  @@unique([providerId, externalId])
  @@index([providerId, enabled, sortOrder])
}

// A launched third-party game. The external session id is the idempotency key
// carried by every wallet callback.
model ProviderSession {
  id                String                @id @default(uuid()) @db.Uuid
  userId            String                @db.Uuid
  providerId        String                @db.Uuid
  gameId            String?               @db.Uuid
  externalSessionId String                @unique
  status            ProviderSessionStatus @default(OPEN)
  launchUrl         String?
  expiresAt         DateTime
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider GameProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  game     ProviderGame? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  transactions ProviderTransaction[]

  @@index([userId, status])
  @@index([providerId, status])
}

// Raw callback audit. Every hit on /games/callback/:code writes one row,
// including forged and malformed ones, so replays are always explainable.
model ProviderCallbackLog {
  id                String                @id @default(uuid()) @db.Uuid
  providerCode      String
  type              ProviderCallbackType? // null when the body did not parse
  externalTxnId     String?
  externalSessionId String?
  signatureValid    Boolean
  httpStatus        Int?
  amount            BigInt?
  currency          String?
  payload           Json
  error             String?
  ip                String?
  createdAt         DateTime              @default(now())

  provider GameProvider @relation(fields: [providerCode], references: [code], onDelete: Cascade)

  @@index([providerCode, createdAt])
  @@index([externalTxnId])
}

// Applied wallet movements. The unique key is per callback type, fixing the
// old bug where a bet and its win shared one idempotency key.
model ProviderTransaction {
  id            String                    @id @default(uuid()) @db.Uuid
  providerCode  String
  type          ProviderCallbackType
  externalTxnId String
  userId        String?                   @db.Uuid
  sessionId     String?                   @db.Uuid
  gameId        String?                   @db.Uuid
  amount        BigInt
  currency      String
  status        ProviderTransactionStatus @default(APPLIED)
  ledgerId      String?                   @db.Uuid
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  provider GameProvider     @relation(fields: [providerCode], references: [code], onDelete: Cascade)
  user     User?            @relation("ProviderTransactions", fields: [userId], references: [id], onDelete: SetNull)
  session  ProviderSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([providerCode, externalTxnId, type])
  @@index([providerCode, createdAt])
  @@index([userId, createdAt])
}
