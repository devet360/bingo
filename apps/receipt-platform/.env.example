# Receipt platform API (separate from Bingo)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
CBE_ENABLED=false
RECEIPT_DATABASE_URL=jdbc:postgresql://localhost:55432/receipt_platform
RECEIPT_DATABASE_USER=receipt_platform
RECEIPT_DATABASE_PASSWORD=change-me-locally
DATABASE_POOL_SIZE=12

# Optional internal relay access. Keep values server-side and out of commits.
RECEIPT_RELAY_URL=
RECEIPT_RELAY_API_KEY=
RECEIPT_RELAY_API_SECRET=
RECEIPT_RELAY_TIMEOUT_MS=15000

# Configure only through the deployment secret manager. No production values belong here.
RECEIPT_KEY_ENCRYPTION_KEY=

# Telegram bot secrets are server-side only. Keep empty until the bot is configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=
