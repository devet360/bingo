# ── Infrastructure ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://bingo:bingo@localhost:5432/bingo?schema=public&connection_limit=20"
REDIS_URL="redis://localhost:6379"

# ── Auth (each secret >= 32 chars; generate with: openssl rand -hex 32) ───────
JWT_ACCESS_SECRET="0f8c2b7a4d1e6f9a3c5b8d0e2f4a6c8b1d3e5f7a9c0b2d4e6f8a1c3b5d7e9f0a"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="9a7c5e3b1d0f2a4c6e8b7d5f3a1c9e0b2d4f6a8c1e3b5d7f9a0c2e4b6d8f1a3c"
JWT_REFRESH_TTL="30d"
OTP_HASH_PEPPER="6b4d2f0a8c1e3b5d7f9a0c2e4b6d8f1a3c5e7b9d0f2a4c6e8b1d3f5a7c9e0b2d"
CONSOLE_TOKEN_SECRET="replace-with-a-32-plus-character-provider-console-shared-secret"

# ── Telegram ───────────────────────────────────────────────────────────────────
BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_WEBAPP_URL="https://app.example.com"
TELEGRAM_BOT_USERNAME="your_bot_username"
TELEGRAM_LOGIN_MAX_AGE_SECS="300"
# Separate BotFather bot for the customer-support chat. Leave unset to disable it.
SUPPORT_BOT_TOKEN="123456:ABC-DEF..."
SUPPORT_HOURS_START="8"
SUPPORT_HOURS_END="22"
SUPPORT_TIMEZONE="Africa/Addis_Ababa"

# ── Game economy (minor units, 1 credit = 100) ─────────────────────────────────
DEFAULT_DEPOSIT_COMMISSION_BPS="300"
DEFAULT_WITHDRAWAL_COMMISSION_BPS="200"
WITHDRAWAL_FEE_BPS="0"

# ── Operational ────────────────────────────────────────────────────────────────
NODE_ENV="development"
# Dokku injects PORT; API_PORT overrides it for local runs.
API_PORT="4000"
CORS_ORIGINS="http://localhost:3000"
LOG_LEVEL="debug"

# ── Web app runtime config (read by apps/web at /config.js) ────────────────────
# On Dokku these are config:set on the bingo-web app; no rebuild required.
API_URL="http://localhost:4000"
SOCKET_URL="http://localhost:4000"

# ── Receipt relay ──────────────────────────────────────────────────────────────
# Public PHP relay on Ethio Telecom hosting (apps/receipt-relay). Serves the
# geo-blocked Telebirr and M-Pesa lookups. These credentials come from the relay
# admin dashboard; relay lookups stay disabled unless both key and secret exist.
RECEIPT_RELAY_URL="https://receipts.example.com"
RECEIPT_RELAY_TIMEOUT_MS="15000"
RECEIPT_RELAY_API_KEY=""
RECEIPT_RELAY_API_SECRET=""

# ── Bingo engine ───────────────────────────────────────────────────────────────
BINGO_ENGINE_ENABLED="true"
MAINTENANCE_INTERVAL_MS="30000"
WORKER_CONCURRENCY="2"
